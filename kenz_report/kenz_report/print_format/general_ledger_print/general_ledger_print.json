 "doctype": "Print Format",
 "font": "Default",
 "html": "<style>\n    body {\n        font-family: Arial, sans-serif;\n        font-size: 10px;\n        color: #000;\n    }\n\n    h2, h3 {\n        text-align: center;\n        margin: 2px;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 10px;\n    }\n\n    table th,\n    table td {\n        border: 1px solid #000;\n        padding: 5px;\n    }\n\n    table th {\n        background: #efefef;\n        text-align: center;\n    }\n\n    .text-right {\n        text-align: right;\n    }\n\n    .header {\n        margin-bottom: 15px;\n    }\n</style>\n\n<div class=\"header\">\n    <h2>{{ company_name }}</h2>\n    <h3>General Ledger</h3>\n\n    <p>\n        <b>From :</b>\n        {{ frappe.utils.formatdate(filters.from_date) }}\n        &nbsp;&nbsp;&nbsp;\n        <b>To :</b>\n        {{ frappe.utils.formatdate(filters.to_date) }}\n    </p>\n</div>\n\n<table>\n<thead>\n<tr>\n    <th>Date</th>\n    <th>Voucher Type</th>\n    <th>Voucher No</th>\n    <th>Party</th>\n    <th>Debit</th>\n    <th>Credit</th>\n    <th>Balance</th>\n</tr>\n</thead>\n<tbody>\n{% set total = namespace(debit=0, credit=0) %}\n{% for row in rows %}\n{% set total.debit = total.debit + (row.debit or 0) %}\n{% set total.credit = total.credit + (row.credit or 0) %}\n<tr>\n<td>{{ frappe.utils.formatdate(row.posting_date) }}</td>\n<td>{{ row.voucher_type }}</td>\n<td>{{ row.voucher_no }}</td>\n<td>{{ row.party or \"\" }}</td>\n<td class=\"text-right\">{{ \"{:,.2f}\".format(row.debit or 0) }}</td>\n<td class=\"text-right\">{{ \"{:,.2f}\".format(row.credit or 0) }}</td>\n<td class=\"text-right\">{{ \"{:,.2f}\".format(row.balance or 0) }}</td>\n</tr>\n{% endfor %}\n<tr>\n<td colspan=\"4\" align=\"right\"><b>Total</b></td>\n<td class=\"text-right\"><b>{{ \"{:,.2f}\".format(total.debit) }}</b></td>\n<td class=\"text-right\"><b>{{ \"{:,.2f}\".format(total.credit) }}</b></td>\n<td></td>\n</tr>\n</tbody>\n</table>",
 "idx": 0,
